PORT=5005
NODE_ENV=development
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
DATABASE_URL=postgresql://postgres:yourpassword@db.your-project.supabase.co:5432/postgres
AUTH_TOKEN_SECRET=replace-with-at-least-32-random-characters
VERIFIER_SIGNUP_CODE=replace-with-verifier-invitation-code
AUDITOR_SIGNUP_CODE=replace-with-regulator-invitation-code
ML_ENGINE_URL=http://localhost:8000
RPC_URL=http://127.0.0.1:8545
CHAIN_ID=31337
COPERNICUS_CLIENT_ID=
COPERNICUS_CLIENT_SECRET=

# --- Local demo ---
# LOCAL_DB=true forces the offline file database (default whenever SUPABASE_URL is not set)
LOCAL_DB=true
# Backend signs for the seeded Anvil demo wallets (only ever enabled on chainId 31337)
DEMO_SIGNERS=true
# RELAYER_PRIVATE_KEY= (required on any non-local network; defaults to Anvil #0 locally)
